# Supabase project settings → API
# Copy this file to .env.local and fill in the values from your own project.
# Only the anon (publishable) key belongs here — it ships to the browser.
# Never put the service-role key in a VITE_ variable.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Push notifications — the public half of a VAPID key pair. Safe to ship to
# the browser (it only identifies the sender to the push service); the
# private half goes to the Edge Functions as a secret, never here.
# Generate a pair with: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key
